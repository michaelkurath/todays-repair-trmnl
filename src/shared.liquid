{% assign selected_repair = data.repair | default: repair %}
{% assign repairs = data.repairs | default: repairs %}
{% assign repair_count = repairs | size %}

{% if selected_repair == blank and repair_count > 0 %}
  {% assign today_seed = "now" | date: "%j" | plus: 0 %}
  {% assign repair_index = today_seed | modulo: repair_count %}

  {% for repair in repairs %}
    {% if forloop.index0 == repair_index %}
      {% assign selected_repair = repair %}
    {% endif %}
  {% endfor %}
{% endif %}

<style>
  .today-repair {
    height: 100%;
    width: 100%;
    box-sizing: border-box;
    color: #111;
  }

  .today-repair__card {
    min-width: 0;
    box-sizing: border-box;
    padding: 18px;
  }

  .today-repair__card--supporting {
    height: 100%;
  }

  .today-repair__kicker {
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: 15px;
    font-weight: 700;
    opacity: 0.72;
  }

  .today-repair__title {
    font-size: 44px;
    line-height: 1.05;
    font-weight: 800;
    margin-top: 12px;
  }

  .today-repair__summary {
    font-size: 22px;
    line-height: 1.25;
    margin-top: 18px;
  }

  .today-repair__section-label {
    font-size: 14px;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    font-weight: 800;
    opacity: 0.64;
    margin-bottom: 6px;
  }

  .today-repair__why,
  .today-repair__caveat {
    font-size: 18px;
    line-height: 1.25;
  }

  .today-repair__source {
    font-size: 13px;
    line-height: 1.2;
    opacity: 0.7;
    word-break: break-word;
  }

  .today-repair__badge {
    display: inline-block;
    border: 2px solid #111;
    border-radius: 4px;
    padding: 5px 8px;
    font-size: 13px;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    font-weight: 800;
  }

  .today-repair__rule {
    border-top: 3px solid #111;
    margin: 18px 0;
  }

  .today-repair--compact .today-repair__card {
    padding: 13px;
  }

  .today-repair--compact .today-repair__title {
    font-size: 26px;
    margin-top: 8px;
  }

  .today-repair--compact .today-repair__summary {
    font-size: 16px;
    line-height: 1.2;
    margin-top: 10px;
  }

  .today-repair--compact .today-repair__source {
    font-size: 11px;
  }

  .today-repair--tiny .today-repair__title {
    font-size: 18px;
    line-height: 1.1;
    margin-top: 6px;
  }

  .today-repair--tiny .today-repair__summary {
    font-size: 12px;
    line-height: 1.15;
    margin-top: 7px;
  }

  .today-repair--tiny .today-repair__card {
    padding: 10px;
  }
</style>
