{% assign selected_repair = data.repair | default: repair %}
{% assign repairs = data.repairs | default: repairs %}
{% assign repair_count = repairs | size %}

{% if selected_repair == blank and repair_count > 0 %}
  {% assign today_seed = "now" | date: "%j" | plus: 0 %}
  {% assign repair_index = today_seed | modulo: repair_count %}

  {% for repair in repairs %}
    {% if forloop.index0 == repair_index %}
      {% assign selected_repair = repair %}
    {% endif %}
  {% endfor %}
{% endif %}

{% if selected_repair %}
  {% assign repair_title_length = selected_repair.title | size %}
  {% assign repair_summary_length = selected_repair.summary | size %}
  {% assign repair_why_length = selected_repair.why_it_matters | size %}
  {% assign repair_caveat_length = selected_repair.caveat | size %}

  {% assign full_title_size = "title--xxlarge lg:text--xxlarge" %}
  {% if repair_title_length <= 40 %}
    {% assign full_title_size = "title--xxlarge lg:text--xxxlarge" %}
  {% endif %}

  {% assign full_summary_size = "description--xlarge lg:description--xxlarge" %}
  {% if repair_summary_length <= 100 %}
    {% assign full_summary_size = "description--xxlarge" %}
  {% endif %}

  {% assign full_why_size = "description--large lg:description--xlarge" %}
  {% if repair_why_length <= 105 %}
    {% assign full_why_size = "description--xlarge lg:description--xxlarge" %}
  {% endif %}

  {% assign full_caveat_size = "description--large lg:description--xlarge" %}
  {% if repair_caveat_length <= 105 %}
    {% assign full_caveat_size = "description--xlarge lg:description--xxlarge" %}
  {% endif %}

  {% assign half_horizontal_title_size = "title--large lg:title--xlarge" %}
  {% if repair_title_length <= 24 %}
    {% assign half_horizontal_title_size = "title--xlarge lg:title--xxlarge" %}
  {% endif %}

  {% assign half_horizontal_summary_size = "lg:description--large" %}
  {% if repair_summary_length <= 110 %}
    {% assign half_horizontal_summary_size = "description--large lg:description--xlarge" %}
  {% endif %}
  {% if repair_summary_length <= 90 %}
    {% assign half_horizontal_summary_size = "description--xlarge lg:description--xxlarge" %}
  {% endif %}

  {% assign half_horizontal_why_size = "lg:description--large" %}
  {% if repair_why_length <= 110 %}
    {% assign half_horizontal_why_size = "description--large lg:description--xlarge" %}
  {% endif %}
  {% if repair_why_length <= 90 %}
    {% assign half_horizontal_why_size = "description--xlarge lg:description--xxlarge" %}
  {% endif %}

  {% assign half_vertical_title_size = "title--large lg:title--xlarge" %}
  {% if repair_title_length <= 24 %}
    {% assign half_vertical_title_size = "title--xlarge lg:title--xxlarge" %}
  {% endif %}

  {% assign half_vertical_summary_size = "lg:description--large" %}
  {% if repair_summary_length <= 100 %}
    {% assign half_vertical_summary_size = "description--large lg:description--xlarge" %}
  {% endif %}
  {% if repair_summary_length <= 85 %}
    {% assign half_vertical_summary_size = "description--xlarge lg:description--xxlarge" %}
  {% endif %}

  {% assign half_vertical_caveat_size = "lg:description--large" %}
  {% if repair_caveat_length <= 75 %}
    {% assign half_vertical_caveat_size = "description--large lg:description--xlarge" %}
  {% endif %}

  {% assign quadrant_title_size = "title--base lg:title--xlarge" %}
  {% if repair_title_length <= 24 %}
    {% assign quadrant_title_size = "title--large lg:title--xxlarge" %}
  {% endif %}

  {% assign quadrant_summary_size = "lg:description--large" %}
  {% if repair_summary_length <= 100 %}
    {% assign quadrant_summary_size = "description--large lg:description--xlarge" %}
  {% endif %}
{% endif %}

{% capture repair_status_icon %}
  <svg class="repair-status-icon" viewBox="0 0 64 64" role="img" aria-label="Repair">
    <g transform="rotate(45 32 32)">
      <rect class="repair-status-icon__bandage" x="9" y="24" width="46" height="16" rx="8"/>
      <circle class="repair-status-icon__dot" cx="18" cy="30" r="2"/>
      <circle class="repair-status-icon__dot" cx="24" cy="34" r="2"/>
    </g>
    <g transform="rotate(-45 32 32)">
      <rect class="repair-status-icon__bandage" x="9" y="24" width="46" height="16" rx="8"/>
      <path class="repair-status-icon__bandage" d="M17 27l8 8M39 27l8 8"/>
    </g>
  </svg>
{% endcapture %}

<style>
  .repair-status-title {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .repair-status-icon {
    width: 18px;
    height: 18px;
    flex: 0 0 auto;
  }

  .repair-status-icon__bandage {
    fill: none;
    stroke: currentColor;
    stroke-width: 7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .repair-status-icon__dot {
    fill: currentColor;
  }
</style>
