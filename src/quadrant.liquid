<div class="layout layout--col layout--top layout--left layout--stretch-x h--full">
  {% if selected_repair %}
    <div class="flex flex--col flex--center gap--xsmall w--full h--full outline rounded p--3">
      <span class="label label--small lg:label--base text--gray-30 1bit:text--black">Repair</span>
      <span class="title {{ quadrant_title_size }}" data-clamp="2" data-clamp-lg-portrait="3">{{ repair_title }}</span>
      <span class="description {{ quadrant_summary_size }}" data-clamp="3" data-clamp-lg-portrait="4">{{ repair_summary }}</span>
      <div class="hidden lg:visible">
        <span class="label label--small lg:label--base text--gray-30 1bit:text--black">Caveat</span>
        <span class="description lg:description--large" data-clamp="2" data-clamp-lg-portrait="3">{{ repair_caveat }}</span>
      </div>
      <span class="label label--small lg:label--base text--gray-30 1bit:text--black">{{ repair_source_name }}</span>
    </div>
  {% else %}
    <div class="flex flex--col gap--small w--full outline rounded p--3">
      <span class="title title--small">No data</span>
    </div>
  {% endif %}
</div>

{% render 'title_bar', title: "Repair" %}
