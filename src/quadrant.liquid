<div class="layout layout--col layout--top layout--left layout--stretch-x">
  {% if selected_repair %}
    <div class="flex flex--col gap--xsmall w--full outline rounded p--3">
      <span class="label label--small text--gray-30">Repair</span>
      <span class="title {{ quadrant_title_size }}" data-clamp="2">{{ selected_repair.title }}</span>
      <span class="description {{ quadrant_summary_size }}" data-clamp="3">{{ selected_repair.summary }}</span>
      <span class="label label--small lg:label--base text--gray-30">{{ selected_repair.source_name }}</span>
    </div>
  {% else %}
    <div class="flex flex--col gap--small w--full outline rounded p--3">
      <span class="title title--small">No data</span>
    </div>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">Repair</span>
</div>
