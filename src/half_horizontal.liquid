<div class="layout layout--row layout--top layout--left layout--stretch gap--medium">
  {% if selected_repair %}
    <div class="flex flex--col gap--small grow basis--0 outline rounded p--3">
      <span class="label label--small text--gray-30">Today's Repair</span>
      <span class="title {{ half_horizontal_title_size }}">{{ selected_repair.title }}</span>
      <span class="description {{ half_horizontal_summary_size }}">{{ selected_repair.summary }}</span>
    </div>
    <div class="flex flex--col gap--small grow basis--0 outline rounded p--3">
      <span class="label label--small text--gray-30">Why it matters</span>
      <span class="description {{ half_horizontal_why_size }}">{{ selected_repair.why_it_matters }}</span>
      <span class="label label--small text--gray-30">Source: {{ selected_repair.source_name }}</span>
    </div>
  {% else %}
    <div class="flex flex--col gap--small w--full outline rounded p--3">
      <span class="title title--large">No repair data yet</span>
    </div>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">Today's Repair</span>
</div>
