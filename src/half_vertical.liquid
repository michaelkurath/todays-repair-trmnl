<div class="layout layout--col layout--top layout--left layout--stretch-x">
  {% if selected_repair %}
    <div class="flex flex--col gap--small w--full">
      <div class="flex flex--col gap--small w--full outline rounded p--3">
        <span class="label label--small text--gray-30">{{ selected_repair.category | replace: "_", " " | upcase }}</span>
        <span class="label label--small text--gray-30">Today's Repair</span>
        <span class="title {{ half_vertical_title_size }}">{{ selected_repair.title }}</span>
        <span class="description {{ half_vertical_summary_size }}">{{ selected_repair.summary }}</span>
      </div>
      <div class="flex flex--col gap--xsmall w--full outline rounded p--3">
        <span class="label label--small text--gray-30">Caveat</span>
        <span class="description {{ half_vertical_caveat_size }}">{{ selected_repair.caveat }}</span>
      </div>
    </div>
  {% else %}
    <div class="flex flex--col gap--small w--full outline rounded p--3">
      <span class="title title--large">No repair data yet</span>
    </div>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">Today's Repair</span>
</div>
