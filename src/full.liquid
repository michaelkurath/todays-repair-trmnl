<div class="layout layout--col layout--top layout--left layout--stretch-x">
  {% if selected_repair %}
    <div class="flex flex--col gap--medium w--full">
      <div class="flex flex--col gap--small w--full outline rounded p--4">
        <span class="label label--small text--gray-30">{{ selected_repair.category | replace: "_", " " | upcase }}</span>
        <span class="label label--small text--gray-30">Today's Repair</span>
        <span class="title title--xxlarge">{{ selected_repair.title }}</span>
        <span class="description description--xlarge">{{ selected_repair.summary }}</span>
      </div>

      <div class="grid grid--cols-2 gap--medium w--full">
        <div class="flex flex--col gap--xsmall outline rounded p--4">
          <span class="label label--small text--gray-30">Why it matters</span>
          <span class="description description--large">{{ selected_repair.why_it_matters }}</span>
        </div>
        <div class="flex flex--col gap--xsmall outline rounded p--4">
          <span class="label label--small text--gray-30">Caveat</span>
          <span class="description description--large">{{ selected_repair.caveat }}</span>
        </div>
      </div>
    </div>
  {% else %}
    <div class="flex flex--col gap--small w--full outline rounded p--4">
      <span class="label label--small text--gray-30">Today's Repair</span>
      <span class="title title--xxlarge">No repair data yet</span>
      <span class="description description--xlarge">Add a JSON payload with a repairs array to start the daily anti-doom screen.</span>
    </div>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">Today's Repair</span>
  {% if selected_repair %}
    <span class="instance">{{ selected_repair.source_name }}</span>
  {% endif %}
</div>
